# Application Configuration
APP_NAME="RBI India Economic Dashboard API"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite for prototyping:
DATABASE_URL="sqlite:///./rbi_data.db"

# Production / Staging PostgreSQL example:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/rbi_explained"

# Data Storage Paths
RAW_DATA_DIR="./data/raw"
PROCESSED_DATA_DIR="./data/processed"
EXPORTS_DATA_DIR="./data/exports"

# Logging
LOG_LEVEL="INFO"

